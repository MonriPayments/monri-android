<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_marginTop="30dp"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="20dp"
    tools:context=".GooglePayActivity">

    <ProgressBar
        android:id="@+id/progress_bar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="40dp"
        android:minHeight="40dp"
        android:visibility="visible"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.monri.android.view.CardMultilineWidget
        android:id="@+id/payment_picker_card_google_pay_activity"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:theme="@style/TextLabel"
        app:layout_constraintBottom_toTopOf="@id/payment_picker_pay_google_pay_activity"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <Button
        android:id="@+id/payment_picker_pay_google_pay_activity"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/content_main_btn_pay"
        app:layout_constraintBottom_toTopOf="@id/proceed_with_google_pay"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/payment_picker_card_google_pay_activity" />

    <Button
        android:id="@+id/proceed_with_google_pay"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/google_pay_activity_proceed_with_google_pay_button_text"
        app:layout_constraintBottom_toTopOf="@id/google_pay_result_textview"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/payment_picker_pay_google_pay_activity" />

    <TextView
        android:id="@+id/google_pay_result_textview"
        android:layout_width="match_parent"
        android:layout_height="300dp"
        android:scrollbars="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>